classDiagram
    direction TB

    %% Pattern 1: Dynamic Guard Factory (Creational)
    class rolesRestrict {
        <<Factory Function>>
        +rolesRestrict(...allowedRoles: string[]) Type~CanActivate~
    }

    class RolesRestriceGuard {
        <<Dynamic Product Class (mixin)>>
        -UsersService userService
        +canActivate(context: ExecutionContext) Promise~boolean~
    }

    class CanActivate {
        <<Product Interface>>
        +canActivate(context: ExecutionContext) boolean
    }

    rolesRestrict ..> RolesRestriceGuard : dynamically synthesizes
    RolesRestriceGuard ..|> CanActivate : implements

    class FlightResolver {
        <<Consumer Resolver>>
        +cancelFlight(id: string) Flight
        +removeFlight(id: string) FlightResponse
        +myAssignedFlights(user: string) Flight[]
    }

    class BookingResolver {
        <<Consumer Resolver>>
        +createBooking(user: string, bookingBody: CreateBooking) Booking
        +modifyBooking(user: string, updateBody: UpdateBooking) Booking
        +updateBooking(user: string, updateBody: UpdateBooking) Booking
        +cancelBooking(user: string, cancelBody: CancelBooking) responseMessage
        +user(booking: Booking) User
        +flight(booking: Booking) Flight
        +seat(booking: Booking) Seat[]
    }

    RolesRestriceGuard ..> FlightResolver : guards cancelFlight & myAssignedFlights
    RolesRestriceGuard ..> BookingResolver : guards create, modify, cancel

    %% Pattern 2, 3, 4: Batch Loader (Architectural)
    class UserDataLoader {
        <<Batch Loader Provider>>
        +userLoader: DataLoader~string, User~
    }

    class FlightDataLoader {
        <<Batch Loader Provider>>
        +flightLoader: DataLoader~string, Flight~
    }

    class SeatDataLoader {
        <<Batch Loader Provider>>
        +seatLoader: DataLoader~string, Seat~
        +seatManyLoader: DataLoader~string, Seat[]~
    }

    BookingResolver --> UserDataLoader : field resolver user()
    BookingResolver --> FlightDataLoader : field resolver flight()
    BookingResolver --> SeatDataLoader : field resolver seat()

    %% Pattern 5: Producer-Consumer (Architectural)
    class SendGridService {
        <<Job Producer>>
        +send(mailData: MailDataRequired) Promise~void~
    }

    class UsersResolver {
        <<Job Producer>>
        +forgetPassword(dto: resetPasswordDto)
    }

    class FlightService {
        <<Job Producer>>
        +cancelFlight(id: string) Promise~Flight~
    }

    class BullMQ_EmailQueue {
        <<Queue Channel / Broker>>
        +"email" queue
        +add(jobName, payload)
    }

    class EmailProcessor {
        <<Consumer Worker>>
        +process(job: Job) Promise~any~
        +onCompleted(job: Job)
        +onFailed(job: Job)
    }

    SendGridService --> BullMQ_EmailQueue : enqueues "sending-token-sendGrid"
    UsersResolver --> BullMQ_EmailQueue : enqueues "sending-token-mailtrap"
    FlightService --> SendGridService : delegates cancellation email
    BullMQ_EmailQueue --> EmailProcessor : consumes async jobs
